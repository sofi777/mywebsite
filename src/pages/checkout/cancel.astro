---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Checkout canceled">
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="text-4xl">Checkout canceled</h1>
    <p class="mt-4 text-warm-brown">No charge was made. You can try again anytime.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-terracotta px-6 py-3 text-warm-cream hover:bg-amber"
    >
      Back to home
    </a>
  </section>
</Layout>

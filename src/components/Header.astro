---
import { business } from "../config/business";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About/Services" },
  { href: "/blog", label: "Blog" },
];
---

<header class="bg-espresso text-warm-cream">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-lg text-warm-cream">{business.name}</a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="cursor-pointer text-2xl md:hidden"
      aria-label="Toggle navigation"
    >
      &#9776;
    </label>

    <nav
      class="absolute inset-x-0 top-[64px] hidden flex-col gap-4 bg-espresso px-6 pb-4 peer-checked:flex md:static md:flex md:flex-row md:items-center md:gap-6 md:bg-transparent md:p-0"
    >
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-warm-cream hover:text-amber">
            {link.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="inline-block rounded-md bg-terracotta px-4 py-2 text-center text-warm-cream hover:bg-amber"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
